# ─── Telegram Bot ───────────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot
# 2. Copy the token it gives you:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Start your new bot, send /start — it replies with your Chat ID:
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Server ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB (required for data storage) ─────────────────────────────────
# Get your connection string from MongoDB Atlas or use local MongoDB
# Example: mongodb://localhost:27017/leadsystem
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/leadsystem
MONGODB_URI=mongodb://localhost:27017/leadsystem

# ─── Optional: Point scraper at a remote API ─────────────────────────
# API_URL=https://your-app.onrender.com

# ─── Optional: OpenAI for smarter lead scoring ───────────────────────
# OPENAI_API_KEY=sk-...
